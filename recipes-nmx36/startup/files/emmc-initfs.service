[Unit]
Description=EMMC EXT4 init
DefaultDependencies=no
Conflicts=shutdown.target
After=tmp.mount var-volatile.mount
Before=init-platform.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/setup_emmc.sh mount
ExecStop=/usr/local/bin/setup_emmc.sh umount
SyslogIdentifier=emmc-initfs

[Install]
WantedBy=local-fs.target
