From ca3a23588367f30a1f79a5708be7c0368d47b09e Mon Sep 17 00:00:00 2001
From: OpenEmbedded <oe.patch@oe>
Date: Mon, 17 Aug 2026 13:41:07 +0800
Subject: [PATCH] add peci-legacy driver

Upstream-Status: Inappropriate [board-specific]

---
 drivers/Kconfig  | 2 ++
 drivers/Makefile | 1 +
 2 files changed, 3 insertions(+)

diff --git a/drivers/Kconfig b/drivers/Kconfig
index b7365b6d8..e9f003044 100644
--- a/drivers/Kconfig
+++ b/drivers/Kconfig
@@ -247,6 +247,8 @@ source "drivers/counter/Kconfig"

 source "drivers/most/Kconfig"

+source "drivers/peci-legacy/Kconfig"
+
 source "drivers/peci/Kconfig"

 source "drivers/hte/Kconfig"
diff --git a/drivers/Makefile b/drivers/Makefile
index a685aeab0..aded2a5dd 100644
--- a/drivers/Makefile
+++ b/drivers/Makefile
@@ -191,6 +191,7 @@ obj-$(CONFIG_GNSS)		+= gnss/
 obj-$(CONFIG_INTERCONNECT)	+= interconnect/
 obj-$(CONFIG_COUNTER)		+= counter/
 obj-$(CONFIG_MOST)		+= most/
+obj-$(CONFIG_PECI_LEGACY)	+= peci-legacy/
 obj-$(CONFIG_PECI)		+= peci/
 obj-$(CONFIG_HTE)		+= hte/
 obj-$(CONFIG_DRM_ACCEL)		+= accel/
--
